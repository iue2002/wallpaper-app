<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>App1</RootNamespace>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <!-- MSI 常用平台默认给 x64 运行时标识，避免生成 framework-dependent 输出 -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType Condition="'$(GenerateAppxPackageOnBuild)' == 'true' or '$(UapAppxPackageBuildMode)' != ''">MSIX</WindowsPackageType>
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Release 默认自包含，确保目标机器无需额外安装 .NET Desktop Runtime -->
    <SelfContained Condition="'$(Configuration)' == 'Release' and '$(SelfContained)' == ''">true</SelfContained>
    <PublishSingleFile Condition="'$(Configuration)' == 'Release' and '$(PublishSingleFile)' == ''">false</PublishSingleFile>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- TranslucentTB 只是任务栏透明功能的参考源码（WinUI 2 / C++/WinRT）。
         其 XAML 用了 WinUI 2 的 AcrylicBrush.BackgroundSource，WinUI 3 已移除该成员，
         让默认 glob 把它卷进来会报 WMC0011。整个目录不参与本项目的编译。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);touming\**</DefaultItemExcludes>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <!-- 双保险：显式把参考代码从默认项里摘掉，XAML 编译器也不会再扫描 touming -->
  <ItemGroup>
    <Page Remove="touming\**\*.xaml" />
    <Compile Remove="touming\**\*.cs" />
    <None Remove="touming\**" />
    <Content Remove="touming\**" />
    <EmbeddedResource Remove="touming\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Assets\LargeTile.scale-200.scale-100.png" />
    <Content Remove="Assets\LargeTile.scale-200.scale-125.png" />
    <Content Remove="Assets\LargeTile.scale-200.scale-150.png" />
    <Content Remove="Assets\LargeTile.scale-200.scale-200.png" />
    <Content Remove="Assets\LargeTile.scale-200.scale-400.png" />
    <Content Remove="Assets\SmallTile.scale-200.scale-100.png" />
    <Content Remove="Assets\SmallTile.scale-200.scale-125.png" />
    <Content Remove="Assets\SmallTile.scale-200.scale-150.png" />
    <Content Remove="Assets\SmallTile.scale-200.scale-200.png" />
    <Content Remove="Assets\SmallTile.scale-200.scale-400.png" />
    <Content Remove="Assets\Square44x44Logo.scale-200.altform-unplated_targetsize-24.scale-100.png" />
    <Content Remove="Assets\Square44x44Logo.scale-200.altform-unplated_targetsize-24.scale-125.png" />
    <Content Remove="Assets\Square44x44Logo.scale-200.altform-unplated_targetsize-24.scale-150.png" />
    <Content Remove="Assets\Square44x44Logo.scale-200.altform-unplated_targetsize-24.scale-200.png" />
    <Content Remove="Assets\Square44x44Logo.scale-200.altform-unplated_targetsize-24.scale-400.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\LockScreenLogo.scale-200.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Square150x150Logo.scale-200.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Square44x44Logo.scale-200.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Square44x44Logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Square150x150Logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Wide310x150Logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\SplashScreen.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\SmallTile.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\LargeTile.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\BadgeLogo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 窗口图标 .ico 文件 -->
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="Package.appxmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- 任务栏透明的注入模块。源码在 native\ExplorerTap，用 native\build-native.ps1 或
         native\ExplorerTap\ExplorerTap.vcxproj 编出来放到这里；缺文件时程序只是关掉该功能。 -->
    <None Include="native\dist\ExplorerTap.dll" Condition="Exists('native\dist\ExplorerTap.dll')">
      <Link>ExplorerTap.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- XAML 诊断的中介 DLL。Win11 26200 的 System32 里没有它，而
         InitializeXamlDiagnosticsEx 必须拿到它的路径，否则返回 0x80070490。
         来自 Windows SDK（Windows Kits\10\bin\x64\XamlDiagnostics）。 -->
    <None Include="native\dist\xamldiagnostics.dll" Condition="Exists('native\dist\xamldiagnostics.dll')">
      <Link>xamldiagnostics.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6584" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.251003001" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
  </ItemGroup>


  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
  </PropertyGroup>
</Project>